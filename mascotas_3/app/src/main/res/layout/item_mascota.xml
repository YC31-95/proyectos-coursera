<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

        <ImageView
                android:id="@+id/imgMascota"
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:scaleType="centerCrop"
                android:src="@drawable/mascota1" />

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="16dp">

            <TextView
                    android:id="@+id/txtNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max"
                    android:textColor="#333333"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Rating"
                    android:textColor="#777777"
                    android:textSize="14sp" />

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                <ImageView
                        android:id="@+id/hueso1"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/hueso_amarillo" />

                <ImageView
                        android:id="@+id/hueso2"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/hueso_amarillo" />

                <ImageView
                        android:id="@+id/hueso3"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/hueso_amarillo" />

                <ImageView
                        android:id="@+id/hueso4"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/hueso_blanco" />

                <ImageView
                        android:id="@+id/hueso5"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/hueso_blanco" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>