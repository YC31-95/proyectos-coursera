<?xml version="1.0" encoding="utf-8"?>

<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8F6FA"
        android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

        <!-- Encabezado -->

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acerca de"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#332D3D"
                android:layout_marginTop="10dp" />

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conoce un poco más sobre nuestra aplicación"
                android:textSize="15sp"
                android:textColor="#77717D"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp" />

        <!-- Tarjeta del desarrollador -->

        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                <ImageView
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:src="@drawable/mascota1"
                        android:scaleType="centerCrop" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐾 Mascotas"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#332D3D"
                        android:layout_marginTop="18dp" />

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aplicación para compartir fotografías de mascotas y calificarlas mediante huesos."
                        android:textSize="16sp"
                        android:textColor="#77717D"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="12dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Información -->

        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👩‍💻 Desarrollador"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#332D3D" />

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Brayan calderon"
                        android:textSize="16sp"
                        android:textColor="#77717D"
                        android:layout_marginTop="6dp" />

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Proyecto académico de Android"
                        android:textSize="15sp"
                        android:textColor="#77717D"
                        android:layout_marginTop="14dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🐾 Hecho con dedicación para los amantes de las mascotas"
                android:textSize="14sp"
                android:textColor="#77717D"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>